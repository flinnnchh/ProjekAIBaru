# Deepgram API Configuration
# Dapatkan API key gratis di: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Opsi Bahasa: 'id' (Bahasa Indonesia) atau 'en' (English)
DEEPGRAM_LANGUAGE=id

# Server Port
PORT=3001

# Google Account Kredensial untuk Bot Meeting (Google Meet Guest / Playwright)
GOOGLE_BOT_EMAIL=your_bot_email@gmail.com
GOOGLE_BOT_PASSWORD=your_bot_password_here

# Nama Tampilan Bot di dalam Meeting
BOT_DISPLAY_NAME=Bot AI

# Corporate VPN / Proxy Settings (Opsional)
VPN_INTERFACE=wg0
VPN_GATEWAY=10.24.0.1

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/ai_meeting_bot

# JWT Authentication
JWT_SECRET=ganti_dengan_string_rahasia_acak_yang_panjang_dan_aman
JWT_EXPIRES_IN=7d

# Multi-User Session Limits
MAX_CONCURRENT_SESSIONS=5

# Google Drive OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/api/drive/oauth/callback


